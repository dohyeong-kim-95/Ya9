{
  "name": "kbo-live-hud",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:api": "cd services/api && uvicorn app.main:app --reload --port 8000",
    "lint": "npm run lint --workspace=apps/web"
  }
}
